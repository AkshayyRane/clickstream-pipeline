# Redpanda broker address (host:port). Matches the port docker-compose exposes to the host.
REDPANDA_BROKER=localhost:19092

# Topic the simulator produces to and the consumer reads from
TOPIC_NAME=clickstream-events

# --- simulator ---
# How many events per second the producer targets, in aggregate across all simulated users
EVENTS_PER_SECOND=10
# Size of the simulated user pool driving concurrent sessions
NUM_CONCURRENT_USERS=50

# --- consumer ---
CONSUMER_GROUP_ID=bronze-writer
# Root directory bronze files are written under (stand-in for a GCS/MinIO bucket)
BRONZE_OUTPUT_PATH=data/bronze/events
# Consumer flushes to disk after this many messages...
CONSUMER_BATCH_SIZE=100
# ...or after this many seconds, whichever comes first
CONSUMER_FLUSH_INTERVAL_SECONDS=10
