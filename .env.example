# Redpanda broker address (host:port). Matches the port docker-compose exposes to the host.
REDPANDA_BROKER=localhost:19092

# Topic the simulator produces to and the consumer reads from
TOPIC_NAME=clickstream-events

# --- simulator ---
# How many events per second the producer targets, in aggregate across all simulated users
EVENTS_PER_SECOND=10
# Size of the simulated user pool driving concurrent sessions
NUM_CONCURRENT_USERS=50

# --- consumer ---
CONSUMER_GROUP_ID=bronze-writer
# Root directory bronze files are written under (stand-in for a GCS/MinIO bucket)
BRONZE_OUTPUT_PATH=data/bronze/events
# Consumer flushes to disk after this many messages...
CONSUMER_BATCH_SIZE=100
# ...or after this many seconds, whichever comes first
CONSUMER_FLUSH_INTERVAL_SECONDS=10

# --- batch_source (historical dataset) ---
# Free Kaggle API token: create a Kaggle account -> Account -> "Create New Token"
# -> downloads kaggle.json containing these two values. See README for details.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Root directory the historical (RetailRocket) events land under, partitioned
# by the event's own date -- separate from the streaming BRONZE_OUTPUT_PATH
# above since the two sources' timestamps don't align (see README).
HISTORICAL_BRONZE_OUTPUT_PATH=data/bronze/events_historical
# Rows per output file when writing the historical bronze partition
BATCH_CHUNK_SIZE=50000

# --- Airflow (docker-compose --profile airflow) ---
# Linux only: set to `id -u` so files written by the containers are owned by
# you, not root. Harmless to leave blank on macOS (Docker Desktop handles it).
AIRFLOW_UID=
# Dev-only fixed credentials for the Airflow webserver login (localhost:8081).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
